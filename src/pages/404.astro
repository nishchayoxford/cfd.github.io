---
import Base from '@/layouts/Base.astro';
import { local } from '@/lib/paths';
---
<Base title="Page not found"><section class="case-study" style="min-height:70svh;padding-bottom:100px"><p class="eyebrow">404 / Outside the domain</p><h1 style="font-size:clamp(2rem,6vw,4rem);margin-block:24px">This page is not here.</h1><p>The address may have changed. The portfolio is one click away.</p><a class="btn" style="margin-top:32px" href={local()}>Back to the portfolio →</a></section></Base>

---
import Section from '@/components/Section.astro';
import publications from '@/data/publications.json';
---
<Section id="publications" title="The published record.">
  <div class="publication-heading" data-reveal><p>Peer-reviewed work in coastal engineering and aerodynamics.</p><a class="text-link" href="https://www.researchgate.net/profile/Nishchay-Tiwari-2">ResearchGate ↗</a></div>
  <ol class="publication-list">
    {publications.map(p => <li class="publication" data-reveal><div class="publication-year">{p.year[0][0]}<span>{p.type==='journal-article'?'Journal article':'Proceedings chapter'}</span></div><div class="publication-main"><h3><a href={`https://doi.org/${p.doi}`}>{p.title}<span aria-hidden="true"> ↗</span></a></h3><p class="publication-venue">{p.venue.join(' · ')}{p.volume ? ` · ${p.volume}${p.issue ? `(${p.issue})` : ''}` : ''}{p.pages_or_article ? ` · ${p.pages_or_article}` : ''}{!p.volume && p.type==='journal-article' ? ' · Ahead of print' : ''}</p><details><summary>Authors & citation</summary><p>{p.authors.join(', ')}.</p><p class="publication-doi">DOI: {p.doi}</p></details></div></li>)}
  </ol>
  <details class="conference-record"><summary>Conference presentations <span>2022 – 2025</span></summary><ul><li><span>2025 / Patras, Greece</span><p>Numerical Investigation of Scour Evolution around Monopile Structures using SedInterFoam</p><small>DMPCO2025 · Conference presentation</small></li><li><span>2022 / Toulouse, France</span><p>Numerical Analysis and Comparison of Flow Structures Produced by Vane and Rod Type Vortex Generators on a Wind Turbine Airfoil</p><small>AERO2022 3AF · Conference presentation</small></li></ul></details>
</Section>

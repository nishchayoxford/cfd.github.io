---
import { site } from '@/data/site';
import { local } from '@/lib/paths';
---
<section id="contact" class="contact-section" aria-labelledby="contact-heading">
  <div class="contact-inner" data-reveal><div><p class="eyebrow">Open channel</p><h2 id="contact-heading">Have a difficult<br />problem in mind?</h2><p>I welcome conversations about computational science, machine learning and research. Let’s compare notes.</p></div><div class="contact-actions"><a class="btn" href={`mailto:${site.email}`}>Start a conversation ↗</a><a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a><span>{site.location}</span><a class="text-link" href={local('resume/')}>View résumé →</a></div></div>
</section>
